@misc{ARLab,
  title       = {ARLab: An AI Enabled, AR-Guided Platform for Zero-Shot Wet-Lab Procedures},
  category    = {Master's Thesis},
  institution = {Traverso Lab, <a href="https://www.broadinstitute.org/" target="_blank">Broad Institute of MIT and Harvard</a>},
  date        = {July 2026 – January 2027 (ongoing)},
  supervisor  = {Prof. Giovanni Traverso},
  description = {I am developing an AI-powered AR assistant on Apple Vision Pro to guide wet-lab procedures without task-specific training. It combines computer vision and object tracking with semantic graph-based procedural reasoning and large language models to track object states, spatial relationships, hand–object interactions, and task progress. I am investigating this approach for real-time guidance, mistake detection, and workflow monitoring in biomedical labs.},
  skills      = {Python, Swift, visionOS, Apple Vision Pro, Computer Vision, Object Tracking, LLMs/VLMs, AR/VR},
  img         = {assets/img/projects/arlab.jpg},
}

@misc{TENG,
  title       = {AI for Joint Angle Monitoring and Movement Classification from TENG Data},
  category    = {Semester Project},
  institution = {<a href="https://bmht.ethz.ch/" target="_blank">BMHT Lab</a>, ETH Zurich},
  date        = {March 2026 – June 2026},
  supervisor  = {Dr. Corin Otesteanu, Dr. Satyaranjan Bairagi, and Prof. Carlo Menon},
  description = {I developed joint-angle regression, movement classification, and gait recognition methods using a self-powered triboelectric nanogenerator (TENG) knee sensor. I designed signal processing and feature extraction pipelines, evaluating TabPFN-based models within participants and on unseen participants (leave-one-participant-out). I also tested participant-specific normalization and analyzed sensor artifacts and inter-subject variability to improve robustness. This work contributed to a manuscript submitted to Advanced Fiber Materials.},
  skills      = {Python, PyTorch, Signal Processing, Machine Learning},
  img         = {assets/img/projects/teng.mp4},
  pdf         = {assets/pdf/Report_TENG_Joint_Angle_Monitoring_Pelin_Kincir.pdf},
}

@misc{SO101Typer,
  title       = {Keyboard-Typing SO-101: Autonomous Keyboard Typing with a Robot Arm},
  category    = {Course Project (Robot Learning)},
  institution = {ETH Zurich},
  date        = {March 2026 - June 2026},
  description = {With my team, we built an SO-101 robot arm that types on a keyboard using eye-in-hand vision. Roboflow key detection, PnP, and hand–eye calibration locate keys in 3D; quadratic-programming-based inverse kinematics guides a hover, recheck, and press sequence. We evaluated fixed sequences, random keys, and sentences scored by Levenshtein distance. Built on LeRobot, the code also includes a state-only MLP behavior-cloning policy plugin. Joint work with Atakan Topaloglu, Samuel Sutanto, and Arda Cinar Demirtas.},
  skills      = {Python, LeRobot, PyTorch, OpenCV, Roboflow, Hand–Eye Calibration, PnP, Inverse Kinematics},
  img         = {assets/img/projects/so101_typer.jpg},
  code        = {https://github.com/ardacinardemirtas/so101-keyboard-typer},
}

@misc{HARonMCU,
  title       = {Human Activity Recognition on Microcontrollers},
  category    = {Course Project (Machine Learning on Microcontrollers)},
  institution = {ETH Zurich},
  date        = {March 2026 – June 2026},
  description = {We trained compact neural networks for human activity recognition and deployed them on MAX78000 and Coral Micro hardware. Using knowledge distillation and 8-bit quantization, we explored the trade-offs between classification accuracy, inference latency, and energy consumption. We evaluated generalization across participants on the WISDM and ADL datasets and compared deployment pipelines for both platforms. Joint work with Berkay Sekeroglu.},
  skills      = {Python, PyTorch, TensorFlow Lite, Knowledge Distillation, Quantization, Embedded ML},
  img         = {assets/img/projects/har_on_mcu.png},
  code        = {https://github.com/pkincir/HARonMCU},
}

